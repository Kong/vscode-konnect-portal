# Copy this file to .env.local and fill in values as needed.
# .env.local is gitignored and is loaded automatically when starting the
# extension with the "Run Extension" debug launch (see .vscode/launch.json).

# Konnect API domain. Leave unset to use the production domain.
# Must be the bare konghq.<tld> domain, for example konghq.com.
# KONNECT_API_DOMAIN=konghq.com
KONNECT_API_DOMAIN=
