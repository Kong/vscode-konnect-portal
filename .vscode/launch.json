{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.cjs"
      ],
      // Local-only environment (e.g. KONNECT_API_DOMAIN) for dev runs.
      // Optional file; the debug session starts normally when it is absent.
      "envFile": "${workspaceFolder}/.env.local",
      "preLaunchTask": "build"
    }
  ]
}
